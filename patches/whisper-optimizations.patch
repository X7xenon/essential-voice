+        // encode audio features starting at offset seek (skip redundant re-encode if auto-detect already encoded seek 0)
+        if (seek == 0 && already_encoded_at_0) {
+            already_encoded_at_0 = false;
+        } else if (!whisper_encode_internal(*ctx, *state, seek, params.n_threads, params.abort_callback, params.abort_callback_user_data)) {
             WHISPER_LOG_ERROR("%s: failed to encode\n", __func__);
             return -6;
         }
