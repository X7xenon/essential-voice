@@ -7000,10 +7009,21 @@ int whisper_full_with_state(
         state->lang_id = lang_id;
         params.language = whisper_lang_str(lang_id);
 
+        // Strictly support only TWO languages: English and Hinglish (Roman Hindi).
+        // If the speech is not English ("en"), treat it as Hindi ("hi") so Whisper emits Hindi tokens
+        // which HinglishConverter seamlessly turns into Romanized Hinglish. This completely eliminates
+        // Urdu (Perso-Arabic), Punjabi, or any other script.
+        if (params.language && std::strcmp(params.language, "en") != 0) {
+            params.language = "hi";
+            state->lang_id = whisper_lang_id("hi");
+        }
+
         WHISPER_LOG_INFO("%s: auto-detected language: %s (p = %f)\n", __func__, params.language, probs[whisper_lang_id(params.language)]);
         if (params.detect_language) {
             return 0;
         }
+
+        already_encoded_at_0 = true;
     }
 
